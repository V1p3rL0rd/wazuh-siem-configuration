# ==============================================================================
# Wazuh SIEM Environment Configuration Template (.env.example)
#
# ИНСТРУКЦИЯ:
# 1. Скопируйте этот файл в '.env':  cp .env.example .env
# 2. Заполните реальные значения ниже.
# 3. Файл '.env' добавлен в .gitignore и не попадет в публичный репозиторий GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сетевые параметры сервера Wazuh Manager
# ------------------------------------------------------------------------------
# IP-адрес или FQDN сервера Wazuh, который будет прописан агентам для подключения.
# Например: 10.100.68.68 или wazuh.garuda.net
WAZUH_SERVER_IP=10.100.68.68
WAZUH_SERVER_FQDN=wazuh.garuda.net

# ------------------------------------------------------------------------------
# 2. Интеграция с Telegram (Оповещения об инцидентах уровня 10 и выше)
# ------------------------------------------------------------------------------
# 1. Получите токен бота у @BotFather в Telegram (команда /newbot).
# 2. Создайте группу/канал, добавьте туда бота и назначьте его администратором.
# 3. Узнайте ID чата через бота @userinfobot или @getmyid_bot (для групп начинается с '-100...').
# Вставьте полученные данные ниже:
TELEGRAM_BOT_TOKEN=<REDACTED_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<REDACTED_TELEGRAM_CHAT_ID>

# ------------------------------------------------------------------------------
# 3. Учетные данные компонентов кластера Wazuh
# ------------------------------------------------------------------------------
# Пароль суперпользователя 'admin' для OpenSearch / Wazuh Indexer.
# Требования к надежности: минимум 12 символов, заглавные/строчные буквы, цифры, спецсимволы.
INDEXER_PASSWORD=<REDACTED_INDEXER_PASSWORD>

# Пароль для сервисной учетной записи API Wazuh Manager ('wazuh-wui' для Dashboard).
API_PASSWORD=<REDACTED_API_PASSWORD>

# ------------------------------------------------------------------------------
# 4. Системные лимиты памяти JVM
# ------------------------------------------------------------------------------
# Выделение оперативной памяти для OpenSearch (Wazuh Indexer).
# Рекомендуется выделять не более 50% свободной памяти хоста (например, 2g или 4g).
INDEXER_JVM_HEAP=2g
