<!-- Baseline Security Detection Rules for Linux and Windows Servers -->
<!-- File: /var/ossec/etc/rules/local_rules.xml -->
<!-- Rule ID Range: 100000 - 100099 -->
<!--
  Rule attachment (verified with wazuh-logtest on Wazuh 4.14):
  - Windows detections use <if_group>windows</if_group>: a Windows event first walks the built-in
    chain (60000 -> channel -> event rule, e.g. 1102 -> 63103). A rule attached only to 60000 is
    never reached; a rule attached to the "windows" group is a child of every rule in that chain.
  - Suppression (level 0) rules are children of the exact rule the event ends on (5156 -> 60103,
    4688 -> 67027); as siblings they would lose to the built-in rule.
-->

<group name="local,custom_baseline,">

  <!-- ===================================================================== -->
  <!-- 1. LINUX / UBUNTU SERVER BASELINE MONITORING                          -->
  <!-- ===================================================================== -->

  <!-- Critical Identity and Privilege Files Tampering (FIM: changed / deleted / added) -->
  <rule id="100001" level="12">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/etc/(shadow|gshadow|sudoers)$|^/etc/sudoers\.d/|^/etc/pam\.d/</field>
    <description>Critical authentication file modified (FIM): $(file)</description>
    <mitre>
      <id>T1078</id>
      <id>T1548.003</id>
    </mitre>
  </rule>

  <!-- Tampering with Core System Binaries.
       Level 9 (below the Telegram threshold): package upgrades replace many binaries at once. -->
  <rule id="100002" level="9">
    <if_sid>550,553,554</if_sid>
    <field name="file" type="pcre2">^/(usr/)?s?bin/</field>
    <description>Core system binary altered or replaced: $(file)</description>
    <mitre>
      <id>T1036</id>
      <id>T1574</id>
    </mitre>
  </rule>

  <!-- Audit Log Destruction / Defense Evasion on Linux -->
  <rule id="100003" level="12">
    <if_group>syslog|audit</if_group>
    <match>rm -rf /var/log|shred /var/log|truncate -s 0 /var/log|journalctl --vacuum</match>
    <description>Audit log tampering or destruction detected on Linux</description>
    <mitre>
      <id>T1070.002</id>
    </mitre>
  </rule>

  <!-- Linux Sudoers or Passwd Modification (auditd keys from agent-configs/linux/audit.rules) -->
  <rule id="100004" level="11">
    <if_group>audit</if_group>
    <field name="audit.key">^sudoers_change$|^passwd_change$</field>
    <description>Privileged identity configuration modified (/etc/passwd, /etc/shadow or /etc/sudoers)</description>
    <mitre>
      <id>T1098</id>
    </mitre>
  </rule>

  <!-- Kernel Module Insertion (Rootkit / Driver Persistence) -->
  <rule id="100005" level="13">
    <if_group>audit</if_group>
    <field name="audit.key">^kernel_modules$</field>
    <description>Kernel module loaded or manipulated (possible rootkit activity)</description>
    <mitre>
      <id>T1547.006</id>
    </mitre>
  </rule>

  <!-- Linux SSH: successful logon after multiple failures from the same address.
       Escalates the built-in 40112 ("Multiple authentication failures followed by a success", level 12) for sshd. -->
  <rule id="100006" level="14">
    <if_sid>40112</if_sid>
    <program_name>^sshd$</program_name>
    <description>CRITICAL: Successful SSH logon following brute-force attack from $(srcip)</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- 2. WINDOWS SERVER BASELINE MONITORING                                 -->
  <!-- ===================================================================== -->

  <!-- Windows Audit Log Cleared (Security Event ID 1102 / System 104) -->
  <rule id="100010" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1102$|^104$</field>
    <description>CRITICAL: Windows Security or System audit log was cleared (Defense Evasion)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <!-- Member Added to Administrators / Domain Admins (Event ID 4728 / 4732 / 4756).
       targetUserName is the GROUP, the added account is memberName / memberSid. -->
  <rule id="100011" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
    <field name="win.eventdata.targetUserName" type="pcre2">(?i)Administrators|Администраторы|Domain Admins|Enterprise Admins</field>
    <description>Account $(win.eventdata.memberName) ($(win.eventdata.memberSid)) added to privileged group $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1098</id>
      <id>T1078.002</id>
    </mitre>
  </rule>

  <!-- New Windows Service Installed (Event ID 7045 / 4697) -->
  <rule id="100012" level="10">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^7045$|^4697$</field>
    <description>New Windows service was installed on $(win.system.computer): $(win.eventdata.serviceName)</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>

  <!-- Obfuscated or Malicious PowerShell Script Execution (Event ID 4104) -->
  <rule id="100014" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4104$</field>
    <field name="win.eventdata.scriptBlockText" type="pcre2">(?i)Invoke-Expression|\bIEX\b|DownloadString|DownloadFile|Net\.WebClient|EncodedCommand|\s-enc\s|FromBase64String|-ExecutionPolicy\s+Bypass</field>
    <description>Suspicious obfuscated or payload-downloading PowerShell command executed</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
  </rule>

  <!-- Suspicious LOLBin execution: Sysmon Event ID 1 (image) -->
  <rule id="100015" level="11">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(certutil|bitsadmin|vssadmin|wmic|regsvr32|mshta|rundll32)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache|-decode|delete\s+shadows|shadowstorage|/i:http|javascript:|vbscript:</field>
    <description>Suspicious LOLBin execution for payload download or shadow copy deletion (Sysmon)</description>
    <mitre>
      <id>T1218</id>
      <id>T1490</id>
    </mitre>
  </rule>

  <!-- Suspicious LOLBin execution: Security Event ID 4688 (newProcessName) -->
  <rule id="100017" level="11">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\(certutil|bitsadmin|vssadmin|wmic|regsvr32|mshta|rundll32)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache|-decode|delete\s+shadows|shadowstorage|/i:http|javascript:|vbscript:</field>
    <description>Suspicious LOLBin execution for payload download or shadow copy deletion (4688)</description>
    <mitre>
      <id>T1218</id>
      <id>T1490</id>
    </mitre>
  </rule>

  <!-- Windows Multiple Failed Logons from one address (Event ID 4625 -> rule 60122) -->
  <rule id="100016" level="11" frequency="8" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Potential Windows logon brute-force attack detected from source IP: $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
  </rule>

  <!-- ===================================================================== -->
  <!-- 3. LOG NOISE REDUCTION & OPTIMIZATION (DROP BENIGN SPAM EVENTS)       -->
  <!-- ===================================================================== -->

  <!-- Drop benign Windows Filtering Platform connection events (5156, 5158: audit success) -->
  <rule id="100020" level="0">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^5156$|^5158$</field>
    <description>Noise Reduction: Suppress Windows Filtering Platform permit packets</description>
  </rule>

  <!-- Drop benign background task process creation (4688 svchost -> taskhostw/conhost).
       Child of built-in 67027 "A process was created" (level 3), otherwise 67027 would win. -->
  <rule id="100021" level="0">
    <if_sid>67027</if_sid>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)\\svchost\.exe$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\(taskhostw|conhost)\.exe$</field>
    <description>Noise Reduction: Suppress Windows benign background task execution</description>
  </rule>

  <!-- Drop Linux cron session open/close noise -->
  <rule id="100022" level="0">
    <if_sid>5501,5502</if_sid>
    <match>CRON|cron:session</match>
    <description>Noise Reduction: Suppress frequent cron session open/close syslog spam</description>
  </rule>

</group>
