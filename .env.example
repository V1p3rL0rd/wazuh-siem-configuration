# ==============================================================================
# .env.example - single environment template for Wazuh SIEM
# ==============================================================================
# Filling it in by hand is NOT required: ./setup.sh asks for missing values
# and saves them to .env (chmod 600).
# Values must not contain spaces, quotes or backslashes (\). The .env file is not committed.

# Wazuh Manager network parameters (used by agents)
WAZUH_SERVER_IP=<IP_ADDRESS>
WAZUH_SERVER_FQDN=<FQDN>

# Telegram (alerts of level 10+): token from @BotFather, group chat ID usually starts with -100...
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID>

# Wazuh Indexer admin password (optional: needed only to apply the ISM retention policy)
INDEXER_PASSWORD=<INDEXER_PASSWORD>

# Wazuh version for agents (not newer than the manager). setup.sh detects it from the manager.
WAZUH_VERSION=<WAZUH_VERSION>
