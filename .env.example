# ==============================================================================
# .env.example - Universal Infrastructure Environment Template
# ==============================================================================
# Copy this file to .env and fill in your environment-specific credentials.
# NEVER commit .env to version control!

# --- Global Environment ---
INFRA_ENV=dev                      # dev, staging, prod
LOG_LEVEL=info

# --- NetOps & IPAM (NetBox MCP) ---
NETBOX_URL=https://netbox.internal.local
NETBOX_RO_TOKEN=<REDACTED_NETBOX_TOKEN>

# --- Observability (Prometheus & Grafana) ---
PROMETHEUS_URL=https://prometheus.internal.local
GRAFANA_URL=https://grafana.internal.local
GRAFANA_API_KEY=<REDACTED_GRAFANA_KEY>

# --- CI/CD & Version Control (GitLab / GitHub) ---
GITLAB_API_URL=https://gitlab.internal.local/api/v4
GITLAB_TOKEN=<REDACTED_GITLAB_TOKEN>

# --- DBA & Database Endpoints (Read-Only Diagnostics) ---
PGHOST=postgres.internal.local
PGPORT=5432
PGDATABASE=app_production
PGUSER=readonly_auditor
PGPASSWORD=<REDACTED_PG_PASSWORD>

MYSQL_HOST=mysql.internal.local
MYSQL_PORT=3306
MYSQL_USER=readonly_auditor
MYSQL_PWD=<REDACTED_MYSQL_PASSWORD>

# --- Wazuh SIEM & Telegram Integration ---
TELEGRAM_BOT_TOKEN=<REDACTED_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<REDACTED_TELEGRAM_CHAT_ID>
INDEXER_PASSWORD=<REDACTED_INDEXER_PASSWORD>
API_PASSWORD=<REDACTED_API_PASSWORD>
WAZUH_SERVER_IP=10.100.68.68
WAZUH_SERVER_FQDN=wazuh.garuda.net

# --- Secrets Management (HashiCorp Vault) ---
VAULT_ADDR=https://vault.internal.local:8200
VAULT_TOKEN=<REDACTED_VAULT_TOKEN>

# --- Kubernetes (Read-Only Kubeconfig) ---
KUBECONFIG=~/.kube/config-readonly
