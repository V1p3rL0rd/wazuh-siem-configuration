# ==============================================================================
# .env.example - единый шаблон окружения Wazuh SIEM
# ==============================================================================
# Заполнять вручную НЕ обязательно: ./setup.sh (хост) и docker/start.sh (Docker)
# сами запросят недостающие значения и сохранят их в .env (chmod 600).
# Значения не должны содержать пробелы, кавычки, \ $ #. Файл .env не коммитится.

# Сетевые параметры сервера Wazuh Manager (используются в SAN сертификатов и агентами)
WAZUH_SERVER_IP=<IP_ADDRESS>
WAZUH_SERVER_FQDN=<FQDN>

# Telegram (алерты уровня 10+): токен у @BotFather, Chat ID группы обычно -100...
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID>

# Пароли (минимум 12 символов; нужны для Docker-режима, для хоста INDEXER_PASSWORD опционален)
INDEXER_PASSWORD=<INDEXER_PASSWORD>
API_PASSWORD=<API_PASSWORD>

# Docker: память JVM Indexer (не более 50% RAM) и версия образов; агенты ставятся той же версии
INDEXER_JVM_HEAP=2g
WAZUH_VERSION=4.9.2
