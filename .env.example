# ==============================================================================
# .env.example - единый шаблон окружения Wazuh SIEM
# ==============================================================================
# Заполнять вручную НЕ обязательно: ./setup.sh сам
# запросит недостающие значения и сохранит их в .env (chmod 600).
# Значения не должны содержать пробелы, кавычки или обратный слеш (\). Файл .env не коммитится.

# Сетевые параметры сервера Wazuh Manager (используются агентами)
WAZUH_SERVER_IP=<IP_ADDRESS>
WAZUH_SERVER_FQDN=<FQDN>

# Telegram (алерты уровня 10+): токен у @BotFather, Chat ID группы обычно -100...
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<TELEGRAM_CHAT_ID>

# Пароль admin Wazuh Indexer (опционален: нужен только для применения ISM-политики)
INDEXER_PASSWORD=<INDEXER_PASSWORD>

# Версия Wazuh: агенты ставятся с закреплением на эту версию (не новее manager)
WAZUH_VERSION=4.14.10
