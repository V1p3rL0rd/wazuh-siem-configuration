# ==============================================================================
# Git Ignore Configuration for Wazuh SIEM Repository
# Prevents accidental commits of private credentials, certificates, and runtime data
# ==============================================================================

# Environment files with real secrets
.env
*.env.local

# SSL/TLS Certificates and Private Keys
*.pem
*.key
*.csr
*.crt
*.cert
docker/certs/*.pem
docker/certs/*.csr
docker/certs/*.srl

# Cache and temporary runtime files
*cache.json
/tmp/
*.tmp
*.log

# Docker volume data mounts (if created locally)
wazuh-indexer-data/
wazuh-manager-data/
wazuh-manager-etc/
wazuh-dashboard-custom/

# OS-generated metadata
.DS_Store
Thumbs.db

# Agent installer temp downloads
Sysmon.zip
wazuh-agent*.msi
wazuh-agent*.deb
