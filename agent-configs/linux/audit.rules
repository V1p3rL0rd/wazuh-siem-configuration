## Linux Auditd Rules Baseline (CIS Benchmark Aligned)
## File destination: /etc/audit/rules.d/99-wazuh-secops.rules

# Remove any existing rules
-D

# Buffer Size (Prevents dropped audit records during spikes)
-b 8192

# Failure Mode: 1 = printk error, 2 = kernel panic (1 is safe for production)
-f 1

## 1. Identity & Credential Store Modifications
-w /etc/group -p wa -k identity_changes
-w /etc/passwd -p wa -k passwd_change
-w /etc/gshadow -p wa -k identity_changes
-w /etc/shadow -p wa -k passwd_change
-w /etc/security/opasswd -p wa -k identity_changes

## 2. Privileged Access & Sudoers Changes
-w /etc/sudoers -p wa -k sudoers_change
-w /etc/sudoers.d/ -p wa -k sudoers_change

## 3. Kernel Module Operations (Rootkit Prevention)
-w /sbin/insmod -p x -k kernel_modules
-w /sbin/rmmod -p x -k kernel_modules
-w /sbin/modprobe -p x -k kernel_modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules
-a always,exit -F arch=b32 -S init_module,finit_module,delete_module -k kernel_modules

## 4. System Time Manipulation
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,stime,clock_settime -k time_change

## 5. Network Environment Configuration
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system_locale
-a always,exit -F arch=b32 -S sethostname,setdomainname -k system_locale
-w /etc/issue -p wa -k system_locale
-w /etc/issue.net -p wa -k system_locale
-w /etc/hosts -p wa -k system_locale
-w /etc/network/ -p wa -k system_locale

## 6. Discretionary Access Control (Chmod/Chown Abuse)
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k perm_mod
-a always,exit -F arch=b32 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=unset -k perm_mod

## 7. Privileged Execution / Suspicious Interactive Utilities
-w /usr/bin/sudo -p x -k privileged_exec
-w /usr/bin/su -p x -k privileged_exec
-w /usr/bin/ncat -p x -k suspicious_network_tool
-w /usr/bin/nc -p x -k suspicious_network_tool
-w /usr/bin/socat -p x -k suspicious_network_tool

# Make configuration immutable until reboot (CIS recommendation).
# NOTE: after this, changing audit rules requires a reboot (install-ubuntu.sh re-runs will not reload them).
-e 2
